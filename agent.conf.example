# vibespice configuration.
# Copy this file to agent.conf (never committed) and fill in the first two lines.
# Environment variables with the same names take priority over this file.

# Your Open WebUI server, with http:// or https://
OWUI_URL=http://localhost:3000
# Settings > Account > API Keys in Open WebUI (starts with sk-)
OWUI_API_KEY=sk-paste-your-key-here

# Optional
# OWUI_MODEL=qwen3:32b
# OWUI_CA=/path/to/your-ca.pem
# NGSPICE=ngspice
# LLM_TIMEOUT=900
